<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>lbabus</AssemblyName>
    <RootNamespace>LabViewBenchmarkActor.CollabBus</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- dotnet-tool packaging: install the pinned SemVer version with `dotnet tool install`. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>lbabus</ToolCommandName>
    <PackageId>LabViewBenchmarkActor.CollabBus</PackageId>

    <!-- SemVer: the single source of truth for `lbabus version` and the released package. -->
    <Version>0.12.0</Version>
    <Authors>LabVIEW-Community-CI-CD</Authors>
    <Description>Shared cross-plane coordination bus CLI for labview-benchmark-actor (WIN &lt;-&gt; LINUX). One versioned binary, one deterministic protocol, pulled from an immutable SemVer release.</Description>
    <PackageProjectUrl>https://github.com/LabVIEW-Community-CI-CD/labview-benchmark-actor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/LabVIEW-Community-CI-CD/labview-benchmark-actor</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <!--
    The Docker-CI edge-case harness (ci/) is its own project (ci/LbaBus.Ci) with its own Program.cs.
    Exclude the whole ci/ tree from THIS project's default globs so the CLI does not try to compile the
    runner's sources (duplicate entry points) or ship harness files inside the lbabus tool package.
  -->
  <ItemGroup>
    <Compile Remove="ci/**/*.cs" />
    <None Remove="ci/**/*" />
    <Content Remove="ci/**/*" />
    <EmbeddedResource Remove="ci/**/*" />
  </ItemGroup>

  <!--
    Version-pinned agent base instructions. Embedding AGENTS.md means every install of THIS lbabus
    version carries byte-identical instructions (surfaced by the `lbabus agents` command), so "same
    version => same base instructions" holds by construction. It is also copied to the build output
    as a known post-build location; sessions materialize it via the `lbabus agents` command.
  -->
  <ItemGroup>
    <EmbeddedResource Include="agents/AGENTS.md" />
    <!--
      Role overlays (agents/roles/ROLE.md): commit-derived, role-specific specializations of the base,
      surfaced by the `lbabus agents` role flags. LogicalName is set explicitly so the manifest resource
      name is a stable `agents.roles.FILE` (default globbing mangles a hyphen in the filename).
    -->
    <EmbeddedResource Include="agents/roles/**/*.md">
      <LogicalName>agents.roles.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="CopyAgentsToOutput" AfterTargets="Build">
    <Copy SourceFiles="agents/AGENTS.md" DestinationFiles="$(OutDir)AGENTS.md" SkipUnchangedFiles="true" />
  </Target>

  <!--
    Version-pinned documentation package (companion to AGENTS.md), embedded + copied to output the same
    way, surfaced by the `lbabus docs` command and gated by the ci-docs harness stage.
  -->
  <ItemGroup>
    <EmbeddedResource Include="docs/DOCS.md" />
  </ItemGroup>

  <Target Name="CopyDocsToOutput" AfterTargets="Build">
    <Copy SourceFiles="docs/DOCS.md" DestinationFiles="$(OutDir)DOCS.md" SkipUnchangedFiles="true" />
  </Target>

  <!--
    Version-pinned REQUIREMENTS bundle: the repo's CANONICAL software requirements spec (SRS) + traceability
    matrix (RTM), embedded BY REFERENCE (single source of truth: docs/requirements/*) so THIS lbabus build
    carries the exact requirements it was cut from. Surfaced by `lbabus docs show srs|rtm` and round-tripped
    by the ci-docs harness stage, so "same version => same requirements" holds and the docs an agent reads
    stay aligned with the build. Explicit LogicalName => a stable manifest resource name (default globbing
    would mangle the ../.. path). The repo-root .dockerignore deliberately keeps docs/ in the build context.
  -->
  <ItemGroup>
    <EmbeddedResource Include="../../docs/requirements/srs.md">
      <LogicalName>docs.requirements.srs.md</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../../docs/requirements/rtm.csv">
      <LogicalName>docs.requirements.rtm.csv</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
