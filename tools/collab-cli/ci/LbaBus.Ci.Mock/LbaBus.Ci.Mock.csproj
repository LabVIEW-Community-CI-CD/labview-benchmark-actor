<Project Sdk="Microsoft.NET.Sdk">

  <!--
    In-container GitHub mock for the lbabus Docker-CI edge-case harness (LINUX plane).
    NO NuGet packages, NO bash: everything is BCL (System.Net.HttpListener). Speaks the exact
    surface in ci/README.md ("Mock contract") — {base}/graphql for discussions and
    {base}/repos/{owner}/{repo}/... for releases + the defect issue-comment sink — routed as a pure
    function of path + GraphQL variables, per fixture repo. The `run-harness` mode starts the
    listener (HttpListener.Start() is synchronous, so it is bound before the runner spawns — no
    readiness race), points LBABUS_GITHUB_API at it, runs the case runner, and exits with its code.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>lbabus-mock</AssemblyName>
    <RootNamespace>LabViewBenchmarkActor.CollabBus.CiMock</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
