# Vagrant reviewer workstation -- a Windows 11 + LabVIEW 2026 VM where an expert human reviewer
# operates the labview-benchmark-actor VS Code extension + the embedded AGENTS.md. Tracking: #108.
#
# USES the labview-benchmark-actor GOLDEN BOX `actor/win11-labview2026` (Windows 11 + LabVIEW 2026 +
# VS Code + Node + git + LabVIEW fixtures + boot-time WinRM self-heal). We add ONLY the
# labview-benchmark-actor bits: the extension .vsix (from the gated `ext-v*` Release), the lbabus
# CLI, and a scratch workspace. See README.md for obtaining/registering the box.
#
# DUAL-PROVIDER. Pick one:
#   VAGRANT_CWD=reviewer-workstation vagrant up --provider virtualbox      # Linux/Ubuntu (LINUX lane; validated here)
#   VAGRANT_CWD=reviewer-workstation vagrant up --provider vmware_desktop  # Windows/VMware (WIN lane)
#
# Box per provider (both are maintainer-held Win+LabVIEW boxes; no public LabVIEW box by design):
#   virtualbox     -> actor/win11-labview2026  (labview-benchmark-actor golden box; override VIHS_REVIEWER_BOX)
#   vmware_desktop -> vihs/labview-cleanroom   (labview-benchmark-actor cleanroom box; override VIHS_REVIEWER_BOX_VMWARE)
# Reviewers without a box build one per the docs (BYO), including their OWN licensed LabVIEW for TC-09.

Vagrant.configure("2") do |config|
  # Runtime-configurable VM identity (#108 follow-up): a future agent can launch
  # multiple reviewer instances with unique names -- identifiable in VirtualBox /
  # VMware -- via LBA_VM_NAME (the VM name) and LBA_VM_HOSTNAME (the guest Windows
  # hostname, sanitized to NetBIOS rules: <=15 chars, [A-Za-z0-9-]). Default = "actor".
  lba_vm_name = ENV.fetch("LBA_VM_NAME", "actor")
  lba_vm_hostname = ENV.fetch("LBA_VM_HOSTNAME", lba_vm_name)
                       .gsub(/[^A-Za-z0-9-]/, "-")[0, 15].sub(/-+$/, "")
  lba_vm_hostname = "actor" if lba_vm_hostname.empty?

  # Default: the labview-benchmark-actor golden box (VirtualBox). Overridden per-provider below.
  config.vm.box = ENV.fetch("VIHS_REVIEWER_BOX", "actor/win11-labview2026")

  config.vm.hostname = lba_vm_hostname
  config.vm.communicator = "winrm"
  # WinRM credentials for the golden box's `vagrant` account. The box uses the standard, DISPOSABLE password
  # `Vagrant1234!` (NOT a secret -- a local, throwaway reviewer VM), so default to `vagrant` / `Vagrant1234!`
  # EXPLICITLY. Leaving these unset lets Vagrant fall back to its built-in `vagrant` / `vagrant`, which does
  # NOT match this box: WinRM then fails with WinRMAuthorizationError, and the repeated failed logons LOCK the
  # guest account -- taking down BOTH WinRM (`vagrant upload` / `vagrant winrm`) AND VBoxManage guestcontrol
  # (VERR_UNRESOLVED_ERROR: the session can no longer even be established). A BYO / repackaged box with
  # different creds overrides via env: VIHS_REVIEWER_WINRM_USER / _PASSWORD / _TRANSPORT.
  config.winrm.username  = ENV.fetch("VIHS_REVIEWER_WINRM_USER", "vagrant")
  config.winrm.password  = ENV.fetch("VIHS_REVIEWER_WINRM_PASSWORD", "Vagrant1234!")
  config.winrm.transport = ENV["VIHS_REVIEWER_WINRM_TRANSPORT"].to_sym if ENV["VIHS_REVIEWER_WINRM_TRANSPORT"]
  config.winrm.timeout = 1800

  # No host folder sync needed: provisioning pulls the .vsix from the GitHub Release.
  config.vm.synced_folder ".", "/vagrant", disabled: true

  # --- VirtualBox (LINUX lane; the golden box is a VirtualBox box; validated on an Ubuntu host) ---
  config.vm.provider "virtualbox" do |vb|
    vb.gui    = true
    vb.memory = ENV.fetch("VIHS_REVIEWER_MEM", "8192")
    vb.cpus   = ENV.fetch("VIHS_REVIEWER_CPUS", "4")
    vb.name   = lba_vm_name
    vb.customize ["modifyvm", :id, "--vram", "128"]
  end

  # --- VMware (WIN lane; defaults to the cleanroom VMware box; WIN owns + refines this block) ---
  config.vm.provider "vmware_desktop" do |v, override|
    override.vm.box = ENV.fetch("VIHS_REVIEWER_BOX_VMWARE", "vihs/labview-cleanroom")
    v.gui = true
    v.vmx["memsize"]     = ENV.fetch("VIHS_REVIEWER_MEM", "8192")
    v.vmx["numvcpus"]    = ENV.fetch("VIHS_REVIEWER_CPUS", "4")
    v.vmx["displayName"] = lba_vm_name
    # Pin the NIC PCI slot the cleanroom box ships with: Vagrant auto-applies it today but warns it will
    # stop in a future release, which could break guest networking/WinRM. Set it explicitly to future-proof.
    v.vmx["ethernet0.pcislotnumber"] = "160"
  end

  # Secure GitHub token hand-off for the INTERNAL-repo release downloads. The token is uploaded as a FILE
  # (the file provisioner does NOT echo its contents, even on failure). Do NOT pass tokens via the shell
  # provisioner `env:` -- Vagrant echoes the full env-prefixed command when a provisioner step fails, which
  # leaks the secret to the console/logs. Provide the token on the host by writing it next to this
  # Vagrantfile as `.gh-token` (git-ignored), e.g.  Set-Content reviewer-workstation/.gh-token (gh auth token).
  gh_token_file = File.expand_path(".gh-token", __dir__)
  if File.exist?(gh_token_file)
    config.vm.provision "gh-token", type: "file",
      source: gh_token_file, destination: "C:/Windows/Temp/lba-gh-token"
  end

  # LBA-specific provisioning only (the golden box already has VS Code/Node/git/LabVIEW):
  # install the extension .vsix (from the ext-v* Release) + the lbabus CLI + a scratch workspace.
  config.vm.provision "reviewer-provision", type: "shell",
    path: "provision.ps1", privileged: true,
    env: {
      "VIHS_REVIEWER_EXT_TAG"    => ENV.fetch("VIHS_REVIEWER_EXT_TAG", "latest"),
      "VIHS_REVIEWER_REPO"       => ENV.fetch("VIHS_REVIEWER_REPO", "LabVIEW-Community-CI-CD/labview-benchmark-actor"),
      "VIHS_REVIEWER_LBABUS_TAG" => ENV.fetch("VIHS_REVIEWER_LBABUS_TAG", "latest"),
    }

  # On-demand reviewer smoke-check (NEVER auto-runs -- invoke explicitly with
  #   vagrant provision --provision-with reviewer-smoke
  # ). Confirms the SCRIPTABLE reviewer test cases over the same WinRM channel: TC-00 (the extension is
  # installed), TC-07 (the lbabus CLI landed on PATH), and a lightweight TC-10 (the folded MCP server
  # shipped inside the installed .vsix). The GUI/LabVIEW cases (TC-01/02/03/06/08/09) stay a human step.
  config.vm.provision "reviewer-smoke", type: "shell", run: "never", privileged: true, inline: <<-'PS1'
    $ErrorActionPreference = 'Continue'
    Write-Host "[smoke] TC-00 -- installed extension(s) matching 'labview':"
    code --list-extensions --show-versions | Select-String -Pattern 'labview' | ForEach-Object { Write-Host "  $_" }
    Write-Host "[smoke] TC-07 -- lbabus CLI:"
    $lbabus = 'C:\lba-bin\lbabus.exe'
    if (Test-Path $lbabus) {
      try { $v = (& $lbabus --version 2>&1 | Select-Object -First 1); Write-Host "  present: $v" }
      catch { Write-Host "  present (version check skipped)" }
    } else { Write-Host "  MISSING" }
    Write-Host "[smoke] TC-10 -- folded MCP server inside the installed extension:"
    $ext = Get-ChildItem "$env:USERPROFILE\.vscode\extensions" -Directory -Filter 'svelderrainruiz.labview-benchmark-actor-*' -ErrorAction SilentlyContinue | Select-Object -First 1
    if ($ext) {
      $mcp = Join-Path $ext.FullName 'out\acg-mcp-bundle\acg-mcp\grid-tools.mjs'
      Write-Host "  extension dir: $($ext.Name)"
      Write-Host ("  folded MCP grid-tools present: {0}" -f (Test-Path $mcp))
    } else { Write-Host "  extension dir NOT FOUND under the reviewer profile" }
    Write-Host "[smoke] DONE"
  PS1
end
